<button class="theme-toggle" type="button" aria-label="ライト／ダークを切り替え" title="ライト／ダークを切り替え">
	<!-- ダーク表示中は太陽（ライトへ）、ライト表示中は月（ダークへ）を表示 -->
	<svg class="sun" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
		<circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
		<g stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
		</g>
	</svg>
	<svg class="moon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
		<path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"></path>
	</svg>
</button>

<script>
	for (const button of document.querySelectorAll('.theme-toggle')) {
		button.addEventListener('click', () => {
			const root = document.documentElement;
			const next = root.dataset.theme === 'light' ? 'dark' : 'light';
			if (next === 'light') {
				root.dataset.theme = 'light';
			} else {
				delete root.dataset.theme;
			}
			try {
				localStorage.setItem('theme', next);
			} catch {}
		});
	}
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.theme-toggle:hover {
		color: var(--heading);
		border-color: var(--border-strong);
	}
	.moon {
		display: none;
	}
	:global([data-theme='light']) .sun {
		display: none;
	}
	:global([data-theme='light']) .moon {
		display: block;
	}
</style>
