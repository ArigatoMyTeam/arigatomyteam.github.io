---
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'projects'>;

const { title, description, tags, url, repo } = Astro.props.data;
---

<article class="card">
	<h3>{title}</h3>
	<p>{description}</p>
	{tags.length > 0 && (
		<ul class="tags">
			{tags.map((tag) => <li>{tag}</li>)}
		</ul>
	)}
	<div class="links">
		{url && <a href={url} target="_blank">サイトを見る ↗</a>}
		{repo && <a href={repo} target="_blank">ソースコード ↗</a>}
	</div>
</article>
<style>
	.card {
		position: relative;
		height: 100%;
		padding: 1.5em;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--card-bg);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}
	.card:hover {
		border-color: rgba(139, 124, 255, 0.5);
		transform: translateY(-3px);
		box-shadow: 0 12px 40px -12px var(--card-glow);
	}
	h3 {
		margin: 0 0 0.5em 0;
		font-size: 1.15em;
	}
	p {
		margin: 0 0 1em 0;
		color: var(--text-muted);
		font-size: 0.93em;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin: 0 0 1em 0;
		padding: 0;
		list-style: none;
	}
	.tags li {
		padding: 0.15em 0.65em;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		color: var(--text-muted);
		font-family: var(--font-code);
		font-size: 0.72em;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em 1.2em;
		font-size: 0.88em;
		white-space: nowrap;
	}
</style>
