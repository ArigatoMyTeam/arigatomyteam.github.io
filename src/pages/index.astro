---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const featured = (await getCollection('projects', ({ data }) => data.featured))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 3em 0 4em;
			}
			.status {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				margin-bottom: 1.5em;
				padding: 0.3em 0.9em;
				border: 1px solid var(--border-strong);
				border-radius: 999px;
				color: var(--text-muted);
				font-family: var(--font-code);
				font-size: 0.78em;
			}
			.status::before {
				content: '';
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: #34d399;
				box-shadow: 0 0 10px #34d399;
			}
			.hero h1 {
				margin-bottom: 0.4em;
				font-size: 3.6em;
				line-height: 1.15;
			}
			.lead {
				max-width: 34em;
				color: var(--text-muted);
				font-size: 1.1em;
			}
			.cta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em;
				margin-top: 2em;
			}
			.btn {
				display: inline-block;
				padding: 0.6em 1.3em;
				border: 1px solid var(--border-strong);
				border-radius: 999px;
				color: var(--heading);
				font-size: 0.92em;
				font-weight: 500;
				transition: border-color 0.2s ease, background 0.2s ease;
			}
			.btn:hover {
				color: var(--heading);
				border-color: var(--heading);
			}
			.btn.primary {
				border-color: transparent;
				background: var(--accent-gradient);
				color: #0a0b10;
			}
			.btn.primary:hover {
				color: #0a0b10;
				opacity: 0.9;
			}
			section {
				margin-bottom: 4.5em;
			}
			.section-head {
				display: flex;
				gap: 1em;
				align-items: flex-end;
				justify-content: space-between;
				margin-bottom: 1.5em;
			}
			.section-head h2 {
				margin: 0;
			}
			.section-head a {
				white-space: nowrap;
				color: var(--text-muted);
				font-size: 0.9em;
			}
			.section-head a:hover {
				color: var(--heading);
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
				gap: 1.25em;
			}
			.posts {
				margin: 0;
				padding: 0;
				list-style: none;
				border-top: 1px solid var(--border);
			}
			.posts a {
				display: flex;
				gap: 1.5em;
				align-items: baseline;
				padding: 1em 0.25em;
				border-bottom: 1px solid var(--border);
				color: var(--text);
				transition: padding 0.2s ease, color 0.2s ease;
			}
			.posts a:hover {
				padding-left: 0.75em;
				color: var(--heading);
			}
			.posts :global(time) {
				flex-shrink: 0;
				color: var(--text-faint);
				font-family: var(--font-code);
				font-size: 0.82em;
			}
			@media (max-width: 720px) {
				.hero {
					padding: 1.5em 0 3em;
				}
				.hero h1 {
					font-size: 2.4em;
				}
				.posts a {
					flex-direction: column;
					gap: 0.1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<span class="status">building &amp; learning</span>
				<h1>こんにちは、<br /><span class="gradient-text">{AUTHOR}</span> です。</h1>
				<p class="lead">
					AI・テクノロジー・マーケットに興味があります。このサイトでは、作ったものと日々の学びを記録しています。
				</p>
				<div class="cta">
					<a class="btn primary" href="/projects">作品を見る</a>
					<a class="btn" href="/blog">ブログを読む</a>
				</div>
			</div>

			<section>
				<div class="section-head">
					<div>
						<span class="eyebrow">// projects</span>
						<h2>注目の作品</h2>
					</div>
					<a href="/projects">すべて見る →</a>
				</div>
				<div class="grid">
					{featured.map((project) => <ProjectCard {...project} />)}
				</div>
			</section>

			<section>
				<div class="section-head">
					<div>
						<span class="eyebrow">// writing</span>
						<h2>最新のブログ</h2>
					</div>
					<a href="/blog">すべて見る →</a>
				</div>
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<FormattedDate date={post.data.pubDate} />
								<span>{post.data.title}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
