---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const featured = (await getCollection('projects', ({ data }) => data.featured))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 1em 0 2em;
			}
			.hero h1 {
				margin-bottom: 0.3em;
			}
			.hero p {
				font-size: 1.1em;
				color: rgb(var(--gray-dark));
			}
			section {
				margin-bottom: 3em;
			}
			.section-head h2 {
				margin: 0 0 0.6em 0;
				font-size: 1.8em;
			}
			.section-head a {
				white-space: nowrap;
			}
			.section-head {
				display: flex;
				gap: 1em;
				align-items: baseline;
				justify-content: space-between;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.5em;
			}
			.posts {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.posts li {
				display: flex;
				gap: 1em;
				padding: 0.6em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.posts time {
				flex-shrink: 0;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.hero h1 {
					font-size: 2em;
				}
				.section-head h2 {
					font-size: 1.5em;
				}
				.posts li {
					flex-direction: column;
					gap: 0.1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>こんにちは、{AUTHOR} です 👋</h1>
				<p>
					AI・テクノロジー・マーケットに興味があります。<br />
					このサイトでは、作ったものと日々の学びを記録しています。
				</p>
			</div>

			<section>
				<div class="section-head">
					<h2>注目の作品</h2>
					<a href="/projects">すべて見る →</a>
				</div>
				<div class="grid">
					{featured.map((project) => <ProjectCard {...project} />)}
				</div>
			</section>

			<section>
				<div class="section-head">
					<h2>最新のブログ</h2>
					<a href="/blog">すべて見る →</a>
				</div>
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<FormattedDate date={post.data.pubDate} />
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
